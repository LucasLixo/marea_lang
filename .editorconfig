root = true

[*.{c,c.in,cpp,cpp.in,h,h.in,hpp,hpp.in,java,kt,txt}]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

# Cmake
[{CMakeLists.txt,cmake/*.cmake}]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

[*.lua]
charset = utf-8
indent_size = 3
indent_style = space
insert_final_newline = true
tab_width = 3
trim_trailing_whitespace = true

[*.{css,html,js,yaml,yml}]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = false
tab_width = 2
trim_trailing_whitespace = true

[*.xml]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = false
tab_width = 4
trim_trailing_whitespace = true

# Markdown syntax treats tabs as 4 spaces
[*.{markdown,md}]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = false
tab_width = 4
trim_trailing_whitespace = true

[{*.bat,*.rc}]
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true

[{*.sh}]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
