implementation Matrix2x2Float32
    #[operator = "*"]
    function multiply(self: Self, other: Self): Self
        return marea.math.multiply_matrix2x2_float32(self, other);
    end

    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return self.column0 == other.column0 and self.column1 == other.column1;
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return self.column0 != other.column0 or self.column1 != other.column1;
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): Vector2Float32
        if index == 0 then
            return self.column0;
        end
        if index == 1 then
            return self.column1;
        end
        unreachable!();
    end
end

