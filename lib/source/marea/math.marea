implementation Vector2Boolean
    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return ((self.x and other.x) or (not self.x and not other.x)) and ((self.y and other.y) or (not self.y and not other.y));
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return (self.x and not other.x) or (not self.x and other.x) or (self.y and not other.y) or (not self.y and other.y);
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): boolean
        if index == 0 then
            return self.x;
        end
        if index == 1 then
            return self.y;
        end
        unreachable!();
    end
end

implementation Vector3Boolean
    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return ((self.x and other.x) or (not self.x and not other.x)) and ((self.y and other.y) or (not self.y and not other.y)) and ((self.z and other.z) or (not self.z and not other.z));
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return (self.x and not other.x) or (not self.x and other.x) or (self.y and not other.y) or (not self.y and other.y) or (self.z and not other.z) or (not self.z and other.z);
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): boolean
        if index == 0 then
            return self.x;
        end
        if index == 1 then
            return self.y;
        end
        if index == 2 then
            return self.z;
        end
        unreachable!();
    end
end

implementation Vector4Boolean
    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return ((self.x and other.x) or (not self.x and not other.x)) and ((self.y and other.y) or (not self.y and not other.y)) and ((self.z and other.z) or (not self.z and not other.z)) and ((self.w and other.w) or (not self.w and not other.w));
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return (self.x and not other.x) or (not self.x and other.x) or (self.y and not other.y) or (not self.y and other.y) or (self.z and not other.z) or (not self.z and other.z) or (self.w and not other.w) or (not self.w and other.w);
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): boolean
        if index == 0 then
            return self.x;
        end
        if index == 1 then
            return self.y;
        end
        if index == 2 then
            return self.z;
        end
        if index == 3 then
            return self.w;
        end
        unreachable!();
    end
end
