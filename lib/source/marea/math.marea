-- The library marea.math, as the language ships it. Each structure has the layout of C, the same as its type in
-- marea/base/MAREAMathVector2.h, MAREAMathVector3.h and MAREAMathVector4.h. A padding field holds zero.

namespace marea.math;

#[visibility = public, layout = c, align = 16]
structure Vector2Float32
    x: float32;
    y: float32;
    padding0: float32;
    padding1: float32;
end

#[visibility = public, layout = c, align = 16]
structure Vector3Float32
    x: float32;
    y: float32;
    z: float32;
    padding: float32;
end

#[visibility = public, layout = c, align = 16]
structure Vector4Float32
    x: float32;
    y: float32;
    z: float32;
    w: float32;
end

#[visibility = public, layout = c, align = 16]
structure Vector2Sinteger32
    x: sinteger32;
    y: sinteger32;
    padding0: sinteger32;
    padding1: sinteger32;
end

#[visibility = public, layout = c, align = 16]
structure Vector3Sinteger32
    x: sinteger32;
    y: sinteger32;
    z: sinteger32;
    padding: sinteger32;
end

#[visibility = public, layout = c, align = 16]
structure Vector4Sinteger32
    x: sinteger32;
    y: sinteger32;
    z: sinteger32;
    w: sinteger32;
end

#[visibility = public, layout = c, align = 4]
structure Vector2Boolean
    x: boolean;
    y: boolean;
    padding0: boolean;
    padding1: boolean;
end

#[visibility = public, layout = c, align = 4]
structure Vector3Boolean
    x: boolean;
    y: boolean;
    z: boolean;
    padding: boolean;
end

#[visibility = public, layout = c, align = 4]
structure Vector4Boolean
    x: boolean;
    y: boolean;
    z: boolean;
    w: boolean;
end

-- The arithmetic operators call the C functions that the language registers under marea.math. The comparisons and the
-- index have no C function, so their bodies are Marea code. Two booleans take no == in this language, so the vectors
-- of boolean compare with and, or and not. The padding is not part of the value.

implementation Vector2Float32
    #[operator = "+"]
    function add(self: Self, other: Self): Self
        return marea.math.add_vector2_float32(self, other);
    end

    #[operator = "-"]
    function subtract(self: Self, other: Self): Self
        return marea.math.subtract_vector2_float32(self, other);
    end

    #[operator = "*"]
    function multiply(self: Self, other: Self): Self
        return marea.math.multiply_vector2_float32(self, other);
    end

    #[operator = "/"]
    function divide(self: Self, other: Self): Self
        return marea.math.divide_vector2_float32(self, other);
    end

    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return self.x == other.x and self.y == other.y;
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return self.x != other.x or self.y != other.y;
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): float32
        if index == 0 then
            return self.x;
        end
        if index == 1 then
            return self.y;
        end
        unreachable!();
    end
end

implementation Vector3Float32
    #[operator = "+"]
    function add(self: Self, other: Self): Self
        return marea.math.add_vector3_float32(self, other);
    end

    #[operator = "-"]
    function subtract(self: Self, other: Self): Self
        return marea.math.subtract_vector3_float32(self, other);
    end

    #[operator = "*"]
    function multiply(self: Self, other: Self): Self
        return marea.math.multiply_vector3_float32(self, other);
    end

    #[operator = "/"]
    function divide(self: Self, other: Self): Self
        return marea.math.divide_vector3_float32(self, other);
    end

    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return self.x == other.x and self.y == other.y and self.z == other.z;
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return self.x != other.x or self.y != other.y or self.z != other.z;
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): float32
        if index == 0 then
            return self.x;
        end
        if index == 1 then
            return self.y;
        end
        if index == 2 then
            return self.z;
        end
        unreachable!();
    end
end

implementation Vector4Float32
    #[operator = "+"]
    function add(self: Self, other: Self): Self
        return marea.math.add_vector4_float32(self, other);
    end

    #[operator = "-"]
    function subtract(self: Self, other: Self): Self
        return marea.math.subtract_vector4_float32(self, other);
    end

    #[operator = "*"]
    function multiply(self: Self, other: Self): Self
        return marea.math.multiply_vector4_float32(self, other);
    end

    #[operator = "/"]
    function divide(self: Self, other: Self): Self
        return marea.math.divide_vector4_float32(self, other);
    end

    #[operator = "=="]
    function equals(self: Self, other: Self): boolean
        return self.x == other.x and self.y == other.y and self.z == other.z and self.w == other.w;
    end

    #[operator = "!="]
    function not_equals(self: Self, other: Self): boolean
        return self.x != other.x or self.y != other.y or self.z != other.z or self.w != other.w;
    end

    #[operator = "[]"]
    function at(self: Self, index: uinteger64): float32
        if index == 0 then
            return self.x;
        end
        if index == 1 then
            return self.y;
        end
        if index == 2 then
            return self.z;
        end
        if index == 3 then
            return self.w;
        end
        unreachable!();
    end
end

