    #define MAREA_VERSION_BUILD @MAREA_METADATA_version_build@ // NOLINT

    #define MAREA_VERSION \
        "@MAREA_METADATA_version_major@.@MAREA_METADATA_version_minor@.@MAREA_METADATA_version_patch@.@MAREA_METADATA_version_build@" // NOLINT

#endif /* MAREA_INCLUDE_BASE_MAREASETTINGSHEADER_H */
