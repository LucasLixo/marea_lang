    #cmakedefine SETTING_USE_STRUCTS_PACKED // NOLINT

    #cmakedefine SETTING_BUILD_DEBUG // NOLINT

    #define MAREA_TITLE "@MAREA_METADATA_title@" // NOLINT

    #define MAREA_LABEL "@MAREA_METADATA_label@" // NOLINT

    #define MAREA_PACKAGE "@MAREA_METADATA_package@" // NOLINT

    #define MAREA_VERSION_MAJOR @MAREA_METADATA_version_major@ // NOLINT

    #define MAREA_VERSION_MINOR @MAREA_METADATA_version_minor@ // NOLINT

