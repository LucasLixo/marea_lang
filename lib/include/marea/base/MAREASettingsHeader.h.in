    #cmakedefine SETTING_USE_STRUCTS_PACKED // NOLINT

    #cmakedefine SETTING_BUILD_DEBUG // NOLINT

    #define MAREA_TITLE "@MAREA_TITLE@" // NOLINT

    #define MAREA_LABEL "@MAREA_LABEL@" // NOLINT

    #define MAREA_PACKAGE "@MAREA_PACKAGE@" // NOLINT

    #define MAREA_VERSION_MAJOR @MAREA_VERSION_MAJOR@ // NOLINT

    #define MAREA_VERSION_MINOR @MAREA_VERSION_MINOR@ // NOLINT

    #define MAREA_VERSION_PATCH @MAREA_VERSION_PATCH@ // NOLINT

    #define MAREA_VERSION_BUILD @MAREA_VERSION_BUILD@ // NOLINT

    #define MAREA_VERSION \
        "@MAREA_VERSION_MAJOR@.@MAREA_VERSION_MINOR@.@MAREA_VERSION_PATCH@.@MAREA_VERSION_BUILD@" // NOLINT

#endif /* MAREA_INCLUDE_BASE_MAREASETTINGSHEADER_H */
