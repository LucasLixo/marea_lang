-- An owner of an opaque type assigned with no move.

namespace main;
require demo.owned;

require c.vulkan as vulkan;

opaque structure Texture;

function check()
    local first: demo.owned<Texture> = vulkan.create_texture();
    local second: demo.owned<Texture> = first;
end
