-- An owner of an opaque type is used after it moved.

namespace main;
require demo.owned;

require c.vulkan as vulkan;

opaque structure Texture;

function check()
    local first: demo.owned<Texture> = vulkan.create_texture();
    local second: demo.owned<Texture> = move first;
    vulkan.present(first);
end
