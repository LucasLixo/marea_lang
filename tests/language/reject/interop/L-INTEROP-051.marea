-- An owner of an opaque type is used after it moved.

namespace main;

import c.vulkan;

opaque structure Texture;

function check()
    local first: owned<Texture> = vulkan.create_texture();
    local second: owned<Texture> = move first;
    vulkan.present(first);
end
