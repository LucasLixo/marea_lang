-- A structure assigned from a name with no copy or move.

namespace main;

structure Point
    x: float64;
    y: float64;
end

function run()
    local first: Point = Point{ x = 0.0, y = 0.0 };
    local second: Point = Point{ x = 1.0, y = 1.0 };
    second = first;
end
