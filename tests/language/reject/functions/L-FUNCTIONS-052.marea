-- A file constant passed to a write borrow parameter.

namespace main;

structure Point
    x: float64;
    y: float64;
end

constant ORIGIN: Point = Point{ x = 0.0, y = 0.0 };

function move_right(#[semantics = reference_mutable] point: Point)
    point.x += 1.0;
end

function run()
    move_right(ORIGIN);
end
