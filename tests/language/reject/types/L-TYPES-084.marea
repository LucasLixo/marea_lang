-- Two implementation blocks that declare one function.

namespace main;

structure Point
    x: float64;
    y: float64;
end

implementation Point
    function sum(self: Point): float64
        return self.x + self.y;
    end
end

implementation Point
    function sum(self: Point): float64
        return self.y + self.x;
    end
end
