-- A switch with a repeated value and a missing variant gives both codes.

namespace main;

enum Color
    Red;
    Green;
    Blue;
end

function name(color: Color): sinteger32
    switch color
        case Color.Red then
            return 1;
        case Color.Red then
            return 2;
    end
end
