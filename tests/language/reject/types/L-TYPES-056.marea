-- A switch where a hex and a decimal literal are one value.

namespace main;

function name(value: sinteger32): sinteger32
    switch value
        case 10 then
            return 1;
        end
        case 0xA then
            return 2;
        end
        default then
            return 0;
        end
    end
end
