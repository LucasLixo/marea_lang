-- A switch over an enum that misses a variant.

namespace main;

enum Color
    Red;
    Green;
    Blue;
end

function name(color: Color): sinteger32
    switch color
        case Color.Red then
            return 1;
        case Color.Green then
            return 2;
    end
end
