-- A type that has the contract function with another signature.

namespace main;

contract Comparable
    function less(self: Self, other: Self): boolean;
end

structure Plain
    value: sinteger32;
end

implementation Plain
    function less(self: Plain): boolean
        return true;
    end
end

function biggest<Item>(left: Item, right: Item): Item where Item: Comparable, Copyable
    return copy left;
end

function run(): Plain
    local one: Plain = Plain{ value = 1 };
    local two: Plain = Plain{ value = 2 };
    return biggest(one, two);
end
