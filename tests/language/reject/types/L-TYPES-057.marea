-- A switch where a constant and its literal are one value.

namespace main;

constant LIMIT: sinteger32 = 100;

function name(value: sinteger32): sinteger32
    switch value
        case LIMIT then
            return 1;
        end
        case 100 then
            return 2;
        end
        default then
            return 0;
        end
    end
end
