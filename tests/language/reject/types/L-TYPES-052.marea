-- A switch that lists a variant twice in two arms.

namespace main;

enum Color
    Red;
    Green;
    Blue;
end

function name(color: Color): sinteger32
    switch color
        case Color.Red then
            return 1;
        case Color.Red then
            return 2;
        default then
            return 0;
    end
end
