-- A local is assigned in one branch only and then read.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(flag: boolean): sinteger32
    local value: sinteger32;
    if flag then
        value = 1;
    end
    local copy_of: sinteger32 = value;
    return 1;
end
