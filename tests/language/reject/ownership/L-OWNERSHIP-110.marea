-- The value copy attribute on an enum parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

enum Mode
    fast;
    slow;
end

function check(#[semantics = value_read_only] mode: Mode)
    local copy_of: Mode = mode;
end
