-- A parameter with no attribute is written (rule 2: the default borrow is read-only).

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(point: Point)
    point.x = 1;
end
