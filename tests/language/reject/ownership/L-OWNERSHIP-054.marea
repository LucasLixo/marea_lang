-- An element of a vector is moved out and the vector is used.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: owned<vector<Point>>): sinteger32
    local point: Point = move points[0];
    local count: sinteger32 = points[0].x;
    return 1;
end
