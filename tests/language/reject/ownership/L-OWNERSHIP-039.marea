-- A structure is moved in a loop body, so the second turn uses a moved value.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local first: Point = make_point();
    local turns: sinteger32 = 0;
    while turns < 2 do
        local second: Point = move first;
        turns += 1;
    end
    return 1;
end
