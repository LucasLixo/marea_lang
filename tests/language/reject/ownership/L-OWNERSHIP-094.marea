-- A nested field of a read-only borrow is written.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] box: Box)
    box.inner.x = 1;
end
