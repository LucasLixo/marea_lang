-- A structure is moved in a for loop and the owner is outside.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local first: Point = make_point();
    for turn in 0 .. 2 do
        local second: Point = move first;
    end
    return 1;
end
