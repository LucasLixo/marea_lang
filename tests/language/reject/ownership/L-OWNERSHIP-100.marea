-- A for each mutable over a read-only vector.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] points: demo.vector<Point>)
    for each item in mutable points do
        item.x = 1;
    end
end
