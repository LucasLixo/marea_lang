-- A vector is moved while a for each reads it.

namespace main;
require demo.owned;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: demo.owned<demo.vector<Point>>): sinteger32
    for each item in points do
        local other: demo.owned<demo.vector<Point>> = move points;
        break;
    end
    return 1;
end
