-- An element of a vector assigned with no word.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: vector<Point>): sinteger32
    local point: Point = points[0];
    return 1;
end
