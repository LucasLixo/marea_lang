-- A structure local with no initial value.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(): sinteger32
    local point: Point;
    local x: sinteger32 = point.x;
    return 1;
end
