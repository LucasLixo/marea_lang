-- A local is assigned in one arm of switch only and then read.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(selector: sinteger32): sinteger32
    local value: sinteger32;
    switch selector
        case 1 then
            value = 1;
        default then
    end
    local copy_of: sinteger32 = value;
    return 1;
end
