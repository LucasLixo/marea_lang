-- A parameter assigned to a local with no word.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] point: Point): sinteger32
    local copy_of: Point = point;
    return 1;
end
