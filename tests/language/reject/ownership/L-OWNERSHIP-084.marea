-- An element is written while a for each reads the vector.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_mutable] points: demo.vector<Point>): sinteger32
    for each item in points do
        points[0] = Point{ x = 1, y = 1 };
    end
    return 1;
end
