-- The keyword mutable on a parameter is a parse error (the grammar spells the write borrow as an attribute).

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function change(mutable point: Point)
    point.x = 1;
end
