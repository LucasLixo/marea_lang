-- A library array assigned with no word (a library type has no copy or move check).

namespace main;

require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] values: demo.vector<sinteger32>): sinteger32
    local second: demo.vector<sinteger32> = values;
    return 1;
end
