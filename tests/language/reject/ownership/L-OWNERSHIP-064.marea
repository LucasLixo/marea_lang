-- A local is assigned in a loop only and then read.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(): sinteger32
    local value: sinteger32;
    for turn in 0 .. 2 do
        value = turn;
    end
    local copy_of: sinteger32 = value;
    return 1;
end
