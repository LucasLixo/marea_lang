-- A structure is moved in one branch and used after the branch.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local first: Point = make_point();
    if first.x == 1 then
        local second: Point = move first;
    end
    local third: sinteger32 = first.x;
    return 1;
end
