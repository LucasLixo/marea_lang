-- A with name is written.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local point: Point = make_point();
    with point as view do
        view.x = 1;
    end
    return 1;
end
