-- A for each variable is written.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] points: vector<Point>)
    for each item in points do
        item.x = 1;
    end
end
