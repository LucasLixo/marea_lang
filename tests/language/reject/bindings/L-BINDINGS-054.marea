-- A chained comparison is not accepted.

namespace main;

function check(): sinteger32
    local a: sinteger32 = 1;
    local b: sinteger32 = 2;
    local c: sinteger32 = 3;
    local ok: boolean = a < b < c;
    return 1;
end
