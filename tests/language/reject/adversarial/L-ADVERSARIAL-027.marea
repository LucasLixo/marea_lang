-- A method is called on a value that was moved.

namespace main;
require demo.owned;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function take_point(point: demo.owned<Point>): sinteger32
    return point.x;
end

implementation Point
    function sum(self: Point): sinteger32
        return self.x + self.y;
    end
end

function check(): sinteger32
    local point: Point = make_point();
    local other: Point = move point;
    return point.sum();
end
