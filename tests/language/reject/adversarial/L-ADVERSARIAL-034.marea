-- from: L-MEMORY-001
-- Mutant of L-MEMORY-001: the return of the last path is dropped.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): Point
    local first: Point = make_point();
    local second: Point = make_point();

end

