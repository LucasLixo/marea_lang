-- from: L-OWNERSHIP-014
-- Mutant of L-OWNERSHIP-014: copy is swapped for move on a for each element.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: vector<Point>): sinteger32
    for each item in points do
        local point: Point = move item;
    end
    return 1;
end

