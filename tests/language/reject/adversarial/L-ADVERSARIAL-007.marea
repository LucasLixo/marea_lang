-- A for each mutable appends to the vector it walks.

namespace main;
require demo.owned;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function take_point(point: demo.owned<Point>): sinteger32
    return point.x;
end

function check(#[semantics = reference_mutable] points: demo.vector<Point>): sinteger32
    for each item in mutable points do
        points.append(make_point());
    end
    return 1;
end
