-- from: L-OWNERSHIP-078
-- Mutant of L-OWNERSHIP-078: the write attribute becomes read-only on the owner of the elements that two calls write.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function two_write(#[semantics = reference_mutable] first: Point, #[semantics = reference_mutable] second: Point)
    first.x = 1;
    second.x = 2;
end

function check(#[semantics = reference_read_only] points: vector<Point>): sinteger32
    two_write(points[0], points[1]);
    return 1;
end

