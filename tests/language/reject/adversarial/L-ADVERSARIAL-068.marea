-- from: L-OWNERSHIP-033
-- Mutant of L-OWNERSHIP-033: one type argument of a local vector is narrowed.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] values: demo.vector<sinteger32>): sinteger32
    local second: demo.vector<sinteger8> = copy values;
    return 1;
end

