-- A file constant is passed to a generic function as a write borrow.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function take_point(point: owned<Point>): sinteger32
    return point.x;
end

constant ORIGIN: Point = Point{ x = 0, y = 0 };

function bump<Item>(#[semantics = reference_mutable] value: Item)
end

function check(): sinteger32
    bump(ORIGIN);
    return 1;
end
