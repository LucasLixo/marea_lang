-- from: L-OWNERSHIP-118
-- Mutant of L-OWNERSHIP-118: copy is swapped for move in a return of a for each element.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] points: demo.vector<Point>): Point
    for each item in points do
        return move item;
    end
    return Point{ x = 0, y = 0 };
end

