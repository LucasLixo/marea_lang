-- from: L-OWNERSHIP-122
-- Mutant of L-OWNERSHIP-122: the copy word is dropped from a borrow in a struct literal.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] point: Point): sinteger32
    local box: Box = Box{ inner = point, count = 1 };
    return 1;
end

