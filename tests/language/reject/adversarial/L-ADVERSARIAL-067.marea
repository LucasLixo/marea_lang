namespace main;
require demo.array;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(values: demo.array<sinteger32, 4>): sinteger32
    local second: demo.array<sinteger8, 4> = values;
    return 1;
end

