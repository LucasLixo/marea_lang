-- from: L-PARALLEL-006
-- Mutant of L-PARALLEL-006: the write attribute becomes read-only on the source of a partition mutable.

namespace main;

require c.array;
require c.slice;
require c.task;

constant WORKER_COUNT: sinteger32 = 4;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function scale_slice(#[semantics = reference_mutable] part: c.slice<float32>, factor: float32)
    for each value in mutable part do
        value *= factor;
    end
end

function sum_slice(#[semantics = reference_read_only] part: c.slice<float32>): float32
    local total: float32 = 0.0;
    for each value in part do
        total += value;
    end
    return total;
end

function check(#[semantics = reference_read_only] values: c.array<float32>, factor: float32)
    fork_join
        partition mutable values into WORKER_COUNT as part do
            spawn scale_slice(part, factor);
        end
    end
end

