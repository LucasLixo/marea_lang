-- from: L-TYPES-111
-- Mutant of L-TYPES-111: the owned wrapper is dropped from a generic parameter that is returned.

namespace main;
require demo.owned;

function same<Item>(value: Item): demo.owned<Item> where Item: Movable
    return value;
end

