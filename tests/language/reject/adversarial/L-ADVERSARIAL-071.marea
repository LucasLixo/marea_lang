-- from: L-BINDINGS-036
-- Mutant of L-BINDINGS-036: the initial value of a local is dropped.

namespace main;

function check(): sinteger32
    local value: uinteger32;
    local shifted: uinteger32 = value << 31;
    return 1;
end

