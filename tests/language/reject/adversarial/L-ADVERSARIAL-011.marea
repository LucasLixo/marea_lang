-- A field of a borrow is returned from an arm of switch.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function take_point(point: owned<Point>): sinteger32
    return point.x;
end

function pick(#[semantics = reference_read_only] box: Box, selector: sinteger32): Point
    switch selector
        case 1 then
            return box.inner;
        default then
            return copy box.inner;
    end
end
