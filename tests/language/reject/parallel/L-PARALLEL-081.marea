-- A partition of a raw pointer.

namespace main;

require demo.pointer;
require demo.memory;

function check()
    unsafe
        local raw: demo.pointer<float32> = demo.memory.address();
        fork_join
            partition raw into 2 as part do
                local unused: sinteger32 = 0;
            end
        end
    end
end
