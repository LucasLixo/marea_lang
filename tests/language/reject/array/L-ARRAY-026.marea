-- swap takes an array of the same count.

namespace main;

require marea.array;

function check()
    local values: marea.array.Array<sinteger32, 4> = marea.array.Array<sinteger32, 4>{};
    local other: marea.array.Array<sinteger32, 2> = marea.array.Array<sinteger32, 2>{};
    values.swap(other);
end
