-- fill changes the array that a for each walks.

namespace main;

require marea.array;

function check()
    local values: marea.array.Array<sinteger32, 4> = marea.array.Array<sinteger32, 4>{ 1, 2, 3, 4 };
    for each value in values do
        values.fill(1);
    end
end
