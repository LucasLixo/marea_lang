-- swap of an array with itself borrows it twice.

namespace main;

require marea.array;

function check()
    local values: marea.array.Array<sinteger32, 4> = marea.array.Array<sinteger32, 4>{ 1, 2, 3, 4 };
    values.swap(values);
end
