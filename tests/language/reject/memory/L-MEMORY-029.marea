-- A return leaves the body of a partition.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(values: slice<sinteger32>)
    fork_join
        partition values into 2 as part do
            return;
        end
    end
end
