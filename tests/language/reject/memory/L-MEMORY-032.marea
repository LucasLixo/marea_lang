-- A field of a scope block local is read after the block.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    do
        local inner: Point = make_point();
    end
    local x: sinteger32 = inner.x;
    return 1;
end
