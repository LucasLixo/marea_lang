-- A name of a nested scope block does not leave it.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    do
        do
            local deep: Point = make_point();
        end
        local other: Point = copy deep;
    end
    return 1;
end
