-- A worker spawned on a write-borrow parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function run(#[semantics = reference_mutable] point: Point)
    fork_join
        spawn write_point(point);
    end
end
