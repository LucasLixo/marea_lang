-- Two constants, one of an implementation block, that read each other.

namespace main;

structure Point
    x: sinteger32;
end

-- The cycle is reported at its first constant.
constant LOOP: sinteger32 = Point.INNER;

implementation Point
    constant INNER: sinteger32 = LOOP;
end
