-- copy of a tuple needs every element to be copyable.

namespace main;

require marea.tuple;

structure Token
    value: sinteger32;
end

function check(pair: marea.tuple.Tuple<Token, sinteger32>)
    local other: marea.tuple.Tuple<Token, sinteger32> = copy pair;
end
