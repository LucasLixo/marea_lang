-- == needs every element of a tuple to support it.

namespace main;

require marea.tuple;
require marea.vector;

function check(left: marea.tuple.Tuple<marea.vector.Vector<sinteger32>, boolean>, right: marea.tuple.Tuple<marea.vector.Vector<sinteger32>, boolean>): boolean
    return left == right;
end
