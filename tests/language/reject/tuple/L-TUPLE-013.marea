-- A tuple literal gives a value of another type.

namespace main;

require marea.tuple;

function check()
    local pair: marea.tuple.Tuple<sinteger32, sinteger32> = marea.tuple.Tuple<sinteger32, sinteger32>{ 1, true };
end
