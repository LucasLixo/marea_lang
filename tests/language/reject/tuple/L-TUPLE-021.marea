-- swap of a tuple with itself borrows it twice.

namespace main;

require marea.tuple;

function check()
    local pair: marea.tuple.Tuple<sinteger32, sinteger32> = marea.tuple.Tuple<sinteger32, sinteger32>{ 1, 2 };
    pair.swap(pair);
end
