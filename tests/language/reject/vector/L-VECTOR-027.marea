-- resize needs an element type that can be copied.

namespace main;

require marea.vector;

structure Token
    value: sinteger32;
end

function check()
    local values: marea.vector.Vector<Token> = marea.vector.Vector<Token>{};
    values.resize(2, Token{ value = 1 });
end
