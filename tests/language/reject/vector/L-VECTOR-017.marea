-- reserve may move the storage that a for each walks.

namespace main;

require marea.vector;

function check()
    local values: marea.vector.Vector<sinteger32> = marea.vector.Vector<sinteger32>{ 1 };
    for each value in values do
        values.reserve(8);
    end
end
