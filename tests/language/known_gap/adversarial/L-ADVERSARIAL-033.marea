-- A nested field of a read-only parameter is written in a switch arm of a generic function.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function take_point(point: owned<Point>): sinteger32
    return point.x;
end

function reset<Item>(#[semantics = reference_read_only] box: Box, flag: Item)
    switch box.count
        case 1 then
            box.inner.x = 0;
        end
        default then
        end
    end
end
