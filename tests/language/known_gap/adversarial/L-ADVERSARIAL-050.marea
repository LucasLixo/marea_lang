-- from: L-OWNERSHIP-012
-- Mutant of L-OWNERSHIP-012: copy is swapped for move on a borrowed parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] point: Point): sinteger32
    local copy_of: Point = move point;
    return 1;
end

