-- from: L-OWNERSHIP-106
-- Mutant of L-OWNERSHIP-106: the write attribute becomes read-only on a primitive parameter that the body writes.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] count: sinteger32)
    count = 1;
end

