-- from: L-OWNERSHIP-083
-- Mutant of L-OWNERSHIP-083: a field of a for each element is stored in a narrower local.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: owned<vector<Point>>): sinteger32
    for each item in points do
        local x: sinteger8 = item.x;
    end
    local other: vector<Point> = move points;
    return 1;
end

