-- from: L-FUNCTIONS-014
-- Mutant of L-FUNCTIONS-014: the write attribute becomes read-only on a parameter the body writes.

namespace main;

structure Point
    x: float64;
    y: float64;
end

function move_right(#[semantics = reference_read_only] point: Point)
    point.x += 1.0;
end

function run(): float64
    local point: Point = Point{ x = 0.0, y = 0.0 };
    move_right(point);
    return point.x;
end

