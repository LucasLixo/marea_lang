-- from: L-OWNERSHIP-127
-- Mutant of L-OWNERSHIP-127: copy is swapped for move on a borrow appended to a vector.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_mutable] points: demo.vector<Point>, #[semantics = reference_read_only] point: Point)
    points.append(move point);
end

