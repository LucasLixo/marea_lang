-- A literal out of range is the value of a constant used by a generic call.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function take_point(point: owned<Point>): sinteger32
    return point.x;
end

constant BIG: uinteger8 = 300;

function same<Item>(#[semantics = reference_read_only] value: Item): Item where Item: Copyable
    return copy value;
end

function check(): uinteger8
    return same(BIG);
end
