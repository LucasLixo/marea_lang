-- from: L-OWNERSHIP-114
-- Mutant of L-OWNERSHIP-114: copy is swapped for move in a return of a borrow.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(point: Point): Point
    return move point;
end

