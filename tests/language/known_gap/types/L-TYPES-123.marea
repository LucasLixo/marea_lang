-- Two overlapping implementation blocks of a generic and a concrete type.

namespace main;

structure Box<Item>
    item: Item;
end

implementation<Item> Box<Item>
    function same(self: Box<Item>): sinteger32
        return 1;
    end
end

implementation Box<sinteger32>
    function same(self: Box<sinteger32>): sinteger32
        return 2;
    end
end
