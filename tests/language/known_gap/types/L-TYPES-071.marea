-- A case value of a variant of another enum.

namespace main;

enum Color
    Red;
    Green;
    Blue;
end

enum Shape
    Circle;
end

function name(color: Color): sinteger32
    switch color
        case Shape.Circle then
            return 1;
        end
        default then
            return 0;
        end
    end
end
