-- partition over an array gives no part until the run time view type exists.

namespace main;

require marea.array;
require c.memory;

function scale_part(#[semantics = reference_mutable] part: c.memory.Slice<float32>)
    for each value in mutable part do
        value *= 2.0;
    end
end

function read_part(part: c.memory.Slice<float32>)
end

function scale_all(#[semantics = reference_mutable] values: marea.array.Array<float32, 8>)
    fork_join
        partition mutable values into 4 as part do
            spawn scale_part(part);
        end
    end
end

function read_all(values: marea.array.Array<float32, 10>)
    fork_join
        partition values into 4 as part do
            spawn read_part(part);
        end
    end
end
