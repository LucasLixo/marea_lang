-- A field of an explicit read-only borrow is changed with a compound operator.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] point: Point)
    point.x += 1;
end
