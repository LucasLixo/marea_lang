-- An element of a read-only vector is written.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] points: vector<Point>)
    points[0] = Point{ x = 1, y = 1 };
end
