-- An owned parameter is used after it was moved on.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function take_point(point: owned<Point>): sinteger32
    return point.x;
end

function check(point: owned<Point>): sinteger32
    local result: sinteger32 = take_point(move point);
    local again: sinteger32 = point.x;
    return 1;
end
