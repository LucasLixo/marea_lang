-- A for each element is moved out of the loop owner.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: vector<Point>): sinteger32
    for each item in points do
        local point: Point = move item;
    end
    return 1;
end
