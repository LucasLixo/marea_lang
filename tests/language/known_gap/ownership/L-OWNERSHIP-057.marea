-- A file constant is moved out.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

constant ORIGIN: Point = Point{ x = 0, y = 0 };

function check(): sinteger32
    local point: Point = move ORIGIN;
    return 1;
end
