-- A read-only borrow is moved out.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] borrowed: Point): sinteger32
    local point: Point = move borrowed;
    return 1;
end
