-- A write borrow of a literal.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function check(): sinteger32
    write_point(Point{ x = 1, y = 2 });
    return 1;
end
