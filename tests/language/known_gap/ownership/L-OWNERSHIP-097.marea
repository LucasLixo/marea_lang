-- A whole read-only borrow is assigned.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(#[semantics = reference_read_only] point: Point)
    point = make_point();
end
