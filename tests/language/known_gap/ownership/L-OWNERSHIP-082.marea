-- A vector is moved while a for each reads it.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: owned<vector<Point>>): sinteger32
    for each item in points do
        local other: vector<Point> = move points;
    end
    return 1;
end
