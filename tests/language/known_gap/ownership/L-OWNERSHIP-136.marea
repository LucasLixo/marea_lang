-- A field of a file constant is passed to a write-borrow parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

constant ORIGIN_BOX: Box = Box{ inner = Point{ x = 0, y = 0 }, count = 0 };

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function check(): sinteger32
    write_point(ORIGIN_BOX.inner);
    return 1;
end
