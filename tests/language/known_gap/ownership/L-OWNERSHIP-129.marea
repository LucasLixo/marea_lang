-- A write borrow of a call result.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function check(): sinteger32
    write_point(make_point());
    return 1;
end
