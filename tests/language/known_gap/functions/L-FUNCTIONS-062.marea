-- A default read-only parameter passed on to a write borrow parameter (settled rule 2).

namespace main;

structure Point
    x: float64;
    y: float64;
end

function move_right(#[semantics = reference_mutable] point: Point)
    point.x += 1.0;
end

function relay(point: Point)
    move_right(point);
end
