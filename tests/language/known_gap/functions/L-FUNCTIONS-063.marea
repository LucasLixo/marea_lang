-- A function type argument whose signature does not match the parameter type.

namespace main;

type BinaryOperation = function(left: sinteger32, right: sinteger32): sinteger32;

function negate(value: sinteger32): sinteger32
    return -value;
end

function apply(operation: BinaryOperation): sinteger32
    return operation(1, 2);
end

function run(): sinteger32
    return apply(negate);
end
