-- A word that looks like a keyword but is not one.

namespace main;

function run(): sinteger32
    local reference: sinteger32 = 1;
    local parallel: sinteger32 = 2;
    local values: sinteger32 = 3;
    local endpoint: sinteger32 = 4;
    return reference + parallel + values + endpoint;
end
