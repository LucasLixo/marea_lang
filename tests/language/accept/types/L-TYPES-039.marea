-- A function in an implementation block of an enum.

namespace main;

enum Color
    Red;
    Green;
    Blue;
end

implementation Color
    function is_red(self: Color): boolean
        return self == Color.Red;
    end
end

function run(): boolean
    local color: Color = Color.Green;
    return color.is_red();
end
