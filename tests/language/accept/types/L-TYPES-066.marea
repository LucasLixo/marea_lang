-- A switch whose arms assign and do not return.

namespace main;

function run(value: sinteger32): sinteger32
    local result: sinteger32 = 0;
    switch value
        case 1 then
            result = 10;
        end
        default then
            result = 20;
        end
    end
    return result;
end
