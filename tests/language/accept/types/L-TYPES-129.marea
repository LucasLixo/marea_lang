-- A for each loop over an array with break and continue.

namespace main;

require c.array;

function sum_array(values: c.array<sinteger32>): sinteger32
    local total: sinteger32 = 0;
    for each value in values do
        if value < 0 then
            continue;
        end
        if value > 1000 then
            break;
        end
        total += value;
    end
    return total;
end
