-- One case that lists many variants.

namespace main;

enum Color
    Red;
    Green;
    Blue;
end

function is_warm(color: Color): boolean
    switch color
        case Color.Red, Color.Green then
            return true;
        case Color.Blue then
            return false;
    end
end
