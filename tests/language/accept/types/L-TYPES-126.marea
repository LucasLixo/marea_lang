-- An if, elseif and else chain that assigns.

namespace main;

function classify(score: sinteger32): sinteger32
    local result: sinteger32 = 0;
    if score >= 90 then
        result = 3;
    elseif score >= 50 then
        result = 2;
    else
        result = 1;
    end
    return result;
end
