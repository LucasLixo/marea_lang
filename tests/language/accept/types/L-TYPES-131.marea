-- A break in the inner of two nested loops.

namespace main;

function run(): sinteger32
    local total: sinteger32 = 0;
    for outer in 0 .. 3 do
        for inner in 0 .. 3 do
            if inner == 2 then
                break;
            end
            end
            total += 1;
        end
    end
    return total;
end
