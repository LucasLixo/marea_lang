-- Every key at a place that the placement matrix gives it.

namespace main;

#![visibility = public, layout = c]

#[visibility = public, layout = c, align = 16, move_only]
structure Light
    #[align = 4]
    x: float32;
end

#[visibility = public, layout = c, pack = 1]
enum Mode
    Fast;
end

#[inline = never, build = release, export = "run_it"]
function run(#[semantics = reference_read_only] light: Light)
end
