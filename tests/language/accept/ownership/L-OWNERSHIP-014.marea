-- A for each element assigned to a local with copy.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: demo.vector<Point>): sinteger32
    for each item in points do
        local point: Point = copy item;
    end
    return 1;
end
