-- A primitive parameter may be marked as a read-only borrow.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] count: sinteger32): sinteger32
    local x: sinteger32 = count;
    return 1;
end
