-- A field of a structure assigned with copy.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local box: Box = Box{ inner = make_point(), count = 1 };
    local point: Point = copy box.inner;
    return 1;
end
