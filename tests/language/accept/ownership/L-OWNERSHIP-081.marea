-- A write borrow and a copy of the same value in one call.

namespace main;
require demo.owned;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function write_take(#[semantics = reference_mutable] first: Point, second: demo.owned<Point>)
    first.x = second.x;
end

function check(): sinteger32
    local point: Point = make_point();
    write_take(point, copy point);
    return 1;
end
