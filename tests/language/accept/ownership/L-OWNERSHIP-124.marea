-- A copy of a borrow is assigned to a field.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(#[semantics = reference_read_only] point: Point): sinteger32
    local box: Box = Box{ inner = make_point(), count = 1 };
    box.inner = copy point;
    return 1;
end
