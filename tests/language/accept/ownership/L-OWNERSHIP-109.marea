-- The value copy attribute on a primitive parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = value_read_only] count: sinteger32): sinteger32
    local x: sinteger32 = count;
    return 1;
end
