-- A write borrow is passed on to a write-borrow parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function write_point(#[semantics = reference_mutable] point: Point)
    point.x = 1;
end

function check(#[semantics = reference_mutable] point: Point)
    write_point(point);
end
