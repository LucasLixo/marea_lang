-- A structure is last used by the call that moves it.

namespace main;
require demo.owned;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function take_point(point: demo.owned<Point>): sinteger32
    return point.x;
end

function check(): sinteger32
    local first: Point = make_point();
    local before: sinteger32 = read_point(first);
    local result: sinteger32 = take_point(move first);
    return 1;
end
