-- A local of an owned type takes a value with move.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local point: Point = make_point();
    local owner: owned<Point> = move point;
    return 1;
end
