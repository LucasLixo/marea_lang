-- A value is copied into an owned parameter.

namespace main;
require demo.owned;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function take_point(point: demo.owned<Point>): sinteger32
    return point.x;
end

function check(): sinteger32
    local point: Point = make_point();
    local x: sinteger32 = take_point(copy point);
    return 1;
end
