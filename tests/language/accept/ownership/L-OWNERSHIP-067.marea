-- Two values are passed to two write-borrow parameters.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function two_write(#[semantics = reference_mutable] first: Point, #[semantics = reference_mutable] second: Point)
    first.x = 1;
    second.x = 2;
end

function check(): sinteger32
    local first: Point = make_point();
    local second: Point = make_point();
    two_write(first, second);
    return 1;
end
