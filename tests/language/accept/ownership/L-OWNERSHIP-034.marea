-- A vector assigned with move.

namespace main;
require demo.owned;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(values: demo.owned<demo.vector<sinteger32>>): sinteger32
    local second: demo.owned<demo.vector<sinteger32>> = move values;
    return 1;
end
