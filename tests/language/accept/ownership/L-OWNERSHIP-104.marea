-- A parameter with no attribute is passed on to a read-borrow parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function check(point: Point): sinteger32
    local x: sinteger32 = read_point(point);
    return 1;
end
