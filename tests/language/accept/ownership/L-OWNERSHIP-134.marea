-- A file constant is passed to a read-borrow parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

constant ORIGIN: Point = Point{ x = 0, y = 0 };

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function check(): sinteger32
    local x: sinteger32 = read_point(ORIGIN);
    return 1;
end
