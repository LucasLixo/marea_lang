-- A value is moved into an owned parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function take_point(point: owned<Point>): sinteger32
    return point.x;
end

function check(): sinteger32
    local point: Point = make_point();
    local x: sinteger32 = take_point(move point);
    return 1;
end
