-- A local initialized from an existing structure with move.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local first: Point = make_point();
    local second: Point = move first;
    return 1;
end
