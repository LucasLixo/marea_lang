-- A parameter with no attribute is only read.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(point: Point): sinteger32
    local x: sinteger32 = point.x;
    return 1;
end
