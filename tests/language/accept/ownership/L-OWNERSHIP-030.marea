-- A slice is a view and is assigned with no word.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(view: slice<sinteger32>): sinteger32
    local second: slice<sinteger32> = view;
    return 1;
end
