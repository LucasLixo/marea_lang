-- Two elements are passed to two write-borrow parameters.

namespace main;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function two_write(#[semantics = reference_mutable] first: Point, #[semantics = reference_mutable] second: Point)
    first.x = 1;
    second.x = 2;
end

function check(#[semantics = reference_mutable] points: demo.vector<Point>): sinteger32
    two_write(points[0], points[1]);
    return 1;
end
