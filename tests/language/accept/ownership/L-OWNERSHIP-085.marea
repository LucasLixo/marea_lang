-- The elements are written through a for each mutable.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_mutable] points: vector<Point>): sinteger32
    for each item in mutable points do
        item.x = 1;
    end
    return 1;
end
