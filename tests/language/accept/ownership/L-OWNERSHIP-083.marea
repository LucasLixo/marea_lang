-- A vector is moved after a for each ended.

namespace main;
require demo.owned;
require demo.vector;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(points: demo.owned<demo.vector<Point>>): sinteger32
    for each item in points do
        local x: sinteger32 = item.x;
    end
    local other: demo.owned<demo.vector<Point>> = move points;
    return 1;
end
