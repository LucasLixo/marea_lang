-- A copy of a borrow is stored in a field of a literal.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_read_only] point: Point): sinteger32
    local box: Box = Box{ inner = copy point, count = 1 };
    return 1;
end
