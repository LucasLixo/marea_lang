-- A primitive parameter may be marked as a write borrow.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_mutable] count: sinteger32)
    count = 1;
end
