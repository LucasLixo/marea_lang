-- An owned parameter is returned and the owner goes up.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(point: owned<Point>): Point
    return point;
end
