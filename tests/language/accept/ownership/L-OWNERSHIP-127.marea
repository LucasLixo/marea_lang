-- A copy of a borrow is appended to a vector.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function check(#[semantics = reference_mutable] points: vector<Point>, #[semantics = reference_read_only] point: Point)
    points.append(copy point);
end
