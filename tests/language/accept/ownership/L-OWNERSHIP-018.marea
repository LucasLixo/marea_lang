-- An existing structure assigned with copy in an arm of switch.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local first: Point = make_point();
    switch first.x
        case 1 then
            local second: Point = copy first;
        end
        default then
        end
    end
    return 1;
end
