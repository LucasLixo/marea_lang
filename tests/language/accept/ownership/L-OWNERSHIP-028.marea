-- A new value from a call needs no word.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local point: Point = make_point();
    local other: Point = make_point();
    other = make_point();
    return 1;
end
