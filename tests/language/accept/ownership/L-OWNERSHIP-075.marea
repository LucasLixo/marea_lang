-- A field and a copy of its owner are passed to a write and a read borrow.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function write_inner(#[semantics = reference_mutable] inner: Point, #[semantics = reference_read_only] outer: Box)
    inner.x = outer.count;
end

function check(): sinteger32
    local box: Box = Box{ inner = make_point(), count = 1 };
    local other: Box = copy box;
    write_inner(box.inner, other);
    return 1;
end
