-- The bit and shift operators of an unsigned integer.

namespace main;

function check(): sinteger32
    local value: uinteger32 = 6;
    local a: uinteger32 = ~value;
    local b: uinteger32 = value & 3;
    local c: uinteger32 = value | 1;
    local d: uinteger32 = value ^ 5;
    local e: uinteger32 = value << 2;
    local f: uinteger32 = value >> 1;
    return 1;
end
