-- The comparison and logical operators.

namespace main;

function check(): sinteger32
    local left: sinteger32 = 1;
    local right: sinteger32 = 2;
    local a: boolean = left < right;
    local b: boolean = left <= right;
    local c: boolean = left >= right and left != right;
    local d: boolean = not a or (b and c);
    return 1;
end
