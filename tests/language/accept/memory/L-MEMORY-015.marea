-- A returned structure is destroyed once, by the caller.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

structure Handle
    id: sinteger32;
end

implementation Handle
    #[operator = "construct"]
    function open(id: sinteger32 = 0)
    end

    #[operator = "destroy"]
    function close()
    end
end

-- output: construct, destroy
function open_handle(): Handle
    local handle: Handle = Handle{ id = 1 };
    return handle;
end

function check(): sinteger32
    local handle: Handle = open_handle();
    return 1;
end
