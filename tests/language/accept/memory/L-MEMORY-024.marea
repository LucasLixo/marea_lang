-- A worker spawned on a read-borrow parameter.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function run(#[semantics = reference_read_only] point: Point)
    fork_join
        spawn read_point(point);
    end
end
