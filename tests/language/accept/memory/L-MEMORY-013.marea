-- A structure made in each turn of a loop is destroyed in the same turn.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

structure Handle
    id: sinteger32;
end

implementation Handle
    #[operator = "construct"]
    function open(id: sinteger32 = 0)
    end

    #[operator = "destroy"]
    function close()
    end
end

-- output: construct, destroy, construct, destroy
function check(): sinteger32
    for turn in 0 .. 1 do
        local handle: Handle = Handle{ id = turn };
    end
    return 1;
end
