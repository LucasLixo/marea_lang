-- A partition body spawns a worker on its part.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function scale_part(#[semantics = reference_mutable] part: slice<float32>, factor: float32)
end

function scale_all(values: slice<float32>, factor: float32)
    fork_join
        partition mutable values into 4 as part do
            spawn scale_part(part, factor);
        end
    end
end
