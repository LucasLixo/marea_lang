-- An arena is lent for a write and then moves to the function that ends it.

namespace main;

require marea.memory;

function fill(#[semantics = reference_mutable] arena: marea.memory.Arena)
end

function finish(arena: marea.memory.Arena)
end

function check(#[semantics = reference_mutable] arena: marea.memory.Arena)
    fill(arena);
    finish(move arena);
end
