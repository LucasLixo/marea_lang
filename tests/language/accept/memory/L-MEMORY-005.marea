-- An owner moves up from an inner scope to an outer one.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function check(): sinteger32
    local outer: Point = make_point();
    do
        local inner: Point = make_point();
        outer = move inner;
    end
    local x: sinteger32 = outer.x;
    return 1;
end
