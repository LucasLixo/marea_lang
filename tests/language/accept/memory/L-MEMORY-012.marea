-- A moved structure is destroyed once, by the new owner.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

structure Handle
    id: sinteger32;
end

implementation Handle
    #[operator = "construct"]
    function open(id: sinteger32 = 0)
    end

    #[operator = "destroy"]
    function close()
    end
end

-- output: construct, destroy
function check(): sinteger32
    local first: Handle = Handle{ id = 1 };
    local second: Handle = move first;
    return 1;
end
