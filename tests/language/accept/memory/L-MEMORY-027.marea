-- Two workers read the same local.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function read_point(#[semantics = reference_read_only] point: Point): sinteger32
    return point.x;
end

function check(): sinteger32
    local point: Point = make_point();
    fork_join
        spawn read_point(point);
        spawn read_point(point);
    end
    return 1;
end
