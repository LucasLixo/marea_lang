-- Two locals are destroyed in reverse order of their creation.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

structure Handle
    id: sinteger32;
end

implementation Handle
    #[operator = "construct"]
    function open(id: sinteger32 = 0)
    end

    #[operator = "destroy"]
    function close()
    end
end

-- output: construct 1, construct 2, destroy 2, destroy 1
function check(): sinteger32
    local first: Handle = Handle{ id = 1 };
    local second: Handle = Handle{ id = 2 };
    return 1;
end
