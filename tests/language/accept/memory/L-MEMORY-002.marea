-- Data goes up through two calls.

namespace main;

structure Point
    x: sinteger32;
    y: sinteger32;
end

structure Box
    inner: Point;
    count: sinteger32;
end

function make_point(): Point
    return Point{ x = 1, y = 2 };
end

function wrap(): Point
    local point: Point = make_point();
    return point;
end

function check(): sinteger32
    local point: Point = wrap();
    return 1;
end
