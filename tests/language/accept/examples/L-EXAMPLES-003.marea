-- Step 10: demo.array<T, N> is a type of the language core, with intrinsic functions. There is no attribute
-- for it. A scalar loop gives the same result as a vector operation.

namespace main;
require demo.array;

#[visibility = public]
function dot_product(left: demo.array<float32, 4>, right: demo.array<float32, 4>): float32
    local product: demo.array<float32, 4> = left * right;
    return product.sum();   -- sum is an intrinsic of demo.array<T, N>
end

-- A reference version for a test: it must give the same result as the SIMD version.
#[visibility = public]
function dot_product_reference(left: demo.array<float32, 4>, right: demo.array<float32, 4>): float32
    local total: float32 = 0.0;
    for index in 0 .. 3 do
        total += left[index] * right[index];
    end
    return total;
end
