-- Step 4: blocks. "do ... end" alone makes a scope without a function.
-- A name declared inside a block ends at its "end". The curly braces are only for literals.
-- Data that a scope owns is freed when the scope ends, in the reverse order of its creation.

namespace main;

require marea.array;

#[visibility = public]
function show_blocks(): sinteger32
    local result: sinteger32 = 1;
    do
        local temporary: sinteger32 = 10;
        result += temporary;
    end
    -- temporary does not exist here
    do
        -- The array belongs to this block. It is freed at the "end". There is no free call.
        local scratch: marea.array<sinteger32> = marea.array<sinteger32>.filled(8, 0);
        result += scratch[0];
    end
    return result;
end
