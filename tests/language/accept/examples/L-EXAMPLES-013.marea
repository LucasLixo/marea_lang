-- Step 7a: collections. Each one has its types fixed when it is created.

namespace main;
require demo.array;

require marea.array;

#[visibility = public]
function show_collections(): sinteger32
    -- marea.array<T>: elements of one type. An element of a primitive type is copied out.
    local values: marea.array<float32> = marea.array<float32>{ 1.0, 2.0, 3.0 };
    local first: float32 = values[0];

    -- demo.array<T, N>: the size is part of the type.
    local fixed: demo.array<float32, 4> = demo.array<float32, 4>{ 0.0, 0.0, 0.0, 0.0 };

    -- demo.array<T, N>: N values stored inline, copied like a primitive.
    local direction: demo.array<float32, 4> = demo.array<float32, 4>{ 1.0, 0.0, 0.0, 0.0 };
    return 0;
end
