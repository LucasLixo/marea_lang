-- A function with a constant default and a file constant.

namespace main;

constant LIMIT: sinteger32 = 10;

function clamp(value: sinteger32, limit: sinteger32 = LIMIT): sinteger32
    if value > limit then
        return limit;
    end
    end
    return value;
end
