-- copy and move of a tuple name.

namespace main;

require marea.tuple;

function check(): sinteger32
    local first: marea.tuple.Tuple<sinteger32, sinteger32> = marea.tuple.Tuple<sinteger32, sinteger32>{ 1, 2 };
    local second: marea.tuple.Tuple<sinteger32, sinteger32> = copy first;
    local third: marea.tuple.Tuple<sinteger32, sinteger32> = move second;
    return first[0] + third[1];
end
