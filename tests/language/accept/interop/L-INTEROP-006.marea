-- An owner of an opaque type held in a local and passed as a borrow.

namespace main;
require demo.owned;

require c.vulkan as vulkan;

opaque structure Texture;

function present(texture: Texture)
    vulkan.present(texture);
end

function show()
    local texture: demo.owned<Texture> = vulkan.create_texture();
    present(texture);
end
