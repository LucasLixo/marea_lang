-- A vector of owners is borrowed by for each and never copied.

namespace main;

require marea.vector;
require c.memory;

structure Point
    x: sinteger32;
    y: sinteger32;
end

function walk(values: marea.vector.Vector<c.memory.Owned<Point>>)
    for each point in values do
        local first: sinteger32 = point.x;
    end
end
