-- pop, insert in the middle and erase move the elements.

namespace main;

require marea.vector;

function check(): sinteger32
    local values: marea.vector.Vector<sinteger32> = marea.vector.Vector<sinteger32>{ 1, 3 };
    values.insert(1, 2);
    values.insert(values.size(), 4);
    local last: sinteger32 = values.pop();
    local gone: sinteger32 = values.erase(0);
    return (last * 1000) + (gone * 100) + (values[0] * 10) + values[1];
end
