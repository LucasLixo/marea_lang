-- Step 7d: safe generics (templates).
-- Rules:
--   1. A type parameter is written in <...> after the name. Its name is PascalCase and short
--      (Item, Key). A value parameter is written with "constant": <constant Count: integer32>.
--   2. The body is checked ONCE, at the definition, against the restrictions. An operation that
--      the restriction does not give is an error in the definition, not at the call.
--   3. A restriction is a "contract": a list of functions that a type must have. It is written
--      after the signature with "where Item: Contract". Without "where", a parameter has no
--      operation at all, only: store it, pass it, return it.
--   4. A type meets a contract when its implementation blocks have the listed functions.
--      There is no inheritance and no virtual table. Dispatch is static.
--   5. Each use with new types makes one copy of the function (monomorphization). It has no
--      cost at run time. "marea expand" shows the copies.
--   6. The type is inferred at the call. It can be written: maximum<integer32>(1, 2).
--   7. No partial specialization and no SFINAE.
--   8. A function with #[export = c] must be concrete, because C has no generics.
--   9. Limit of 64 levels of instantiation.
--   10. Several restrictions: "where Item: Comparable, Printable and Key: Hashable".
--   11. Built-in contracts: Copyable (the type can use "copy") and Movable (the type can use
--      "move"). A generic can not use "copy" or "move" without one of them. The checker gives
--      them, and the user never writes an implementation for them: a primitive and a #[value]
--      type are Copyable. A #[move_only] type and owned<T> are only Movable.

namespace types.generics;

import collections.array;

-- A contract. The type that meets it is named in the signature as "Self".
#[public]
contract Comparable
    function less(self: Self, other: Self): boolean;
end

#[public]
contract Printable
    function describe(self: Self): string;
end

-- A type parameter with one restriction.
#[public]
function maximum<Item>(left: Item, right: Item): Item where Item: Comparable, Copyable
    if left.less(right) then
        return copy right;
    end
    return copy left;
end

-- Two contracts on one parameter.
#[public]
function larger_description<Item>(left: Item, right: Item): string where Item: Comparable, Printable, Copyable
    local winner: Item = maximum(left, right);
    return winner.describe();
end

-- A reference can not be returned. The function gives a copy, so the type must be Copyable.
#[public]
function first_of<Item>(values: array<Item>): Item where Item: Copyable
    return copy values[0];
end

-- Two type parameters, no restriction needed to keep the pair.
#[public]
structure Pair<First, Second>
    first: First;
    second: Second;
end

#[public]
implementation<First, Second> Pair<First, Second>
    function swap(self: owned<Pair<First, Second>>): Pair<Second, First> where First: Movable and Second: Movable
        return Pair<Second, First>{ first = move self.second, second = move self.first };
    end
end

-- A value parameter: the size is part of the type, known at compile time.
#[public]
structure Buffer<Item, constant Count: integer32>
    items: array<Item, Count>;
end

#[public]
implementation<Item, constant Count: integer32> Buffer<Item, Count>
    function capacity(self: Buffer<Item, Count>): integer32
        return Count;
    end
end

-- A move-only type: the contract says that the type is moved, so a generic can not copy it.
#[public]
function take<Item>(value: owned<Item>): owned<Item> where Item: Movable
    return value;
end

-- A type that meets Comparable, Printable and Copyable.
#[public, value]
structure Score
    value: integer32;
end

#[public]
implementation Score
    function less(self: Score, other: Score): boolean
        return self.value < other.value;
    end

    function describe(self: Score): string
        return "score";
    end
end

#[public]
function show_generics(): string
    local best: Score = maximum(Score{ value = 3 }, Score{ value = 9 });   -- Item is Score
    local number: integer32 = maximum<integer32>(4, 8);                     -- Item written
    local fixed: Buffer<float32, 16> = Buffer<float32, 16>{ items = array<float32, 16>.filled(0.0) };
    local size: integer32 = fixed.capacity();
    -- An error, found at the definition of "bad": Item has no operation "+".
    --   function bad<Item>(left: Item, right: Item): Item
    --       return left + right;
    --   end
    return larger_description(best, best);
end
