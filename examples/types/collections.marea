-- Step 7a: collections. Each one has its types fixed when it is created.

namespace types.collections;

require marea.array;
require marea.vector;

#[visibility = public]
function show_collections(): sinteger32
    -- marea.vector.Vector<T>: elements of one type, as many as it holds. An element of a primitive type is copied out.
    local values: marea.vector.Vector<float32> = marea.vector.Vector<float32>{ 1.0, 2.0, 3.0 };
    local first: float32 = values[0];

    -- marea.array.Array<T, N>: the size is part of the type.
    local fixed: marea.array.Array<float32, 4> = marea.array.Array<float32, 4>{ 0.0, 0.0, 0.0, 0.0 };

    -- marea.array.Array<T, N>: N values stored inline, copied like a primitive.
    local direction: marea.array.Array<float32, 4> = marea.array.Array<float32, 4>{ 1.0, 0.0, 0.0, 0.0 };
    return 0;
end
