-- Step 13: C libraries. A required namespace calls the C function with its own name, and the
-- language converts the types at the border (string <-> char pointer, sinteger32 <-> int).
-- The root "demo" is registered by the host of the tests, so the example names no real library.

namespace interop.c_library;

require demo.math.pow as power;
require demo.io;

#[visibility = public]
function show_c(): float64
    print!("{}", power(2.0, 10.0));
    return power(2.0, 0.5);
end
