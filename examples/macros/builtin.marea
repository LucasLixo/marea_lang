-- Step 16: built-in macros.
-- Only the compiler defines macros. The language has NO "macro" keyword, so a user cannot
-- create one. A user who needs more writes a function, a generic function, a compile_time
-- function or an attribute.
-- Rules:
--   1. A macro call is written with "!": name!(arguments). The "!" shows that the compiler
--      expands it. A name without "!" is always a normal function.
--   2. A macro is a reserved name in every namespace. A user symbol cannot use it.
--   3. Every macro is typed and checked. The arguments have a fixed type, and a wrong call is
--      an error at the call line, not in the expanded code.
--   4. A macro gives one value or no value, and it is expanded before the type checker, so
--      ownership rules apply to the result as to any other code.
--   5. "marea expand" shows the code after the expansion.
-- List of built-in macros:
--   assert!(condition, message)         stops with the message when the condition is false
--   debug_assert!(condition, message)   same, only in a build = debug build; nothing in release
--   unreachable!()                      a point that must never run; stops with an error
--   compile_error!(message)             stops the compile with the message
--   static_assert!(condition, message)  checks a constant condition at compile time
--   include_bytes!(path)                embeds a file as c.array<uinteger8>, path relative to this file
--   include_text!(path)                 embeds a file as a string
--   format!(text, values...)            builds a string. The caller becomes its owner.
--   print!(text, values...)             writes a formatted text to the standard output
--   log!(level, text, values...)        print with file, line and level. The level is a bare name: trace,
--                                       debug, info, warning or error
--   line!()  file!()  namespace!()      place of the call, as constants

namespace macros.builtin;

import collections.array;
import attributes.layout;

-- The format text is checked at compile time: the count and the type of every {} must match.
-- No printf-like variadic call exists, so a wrong format cannot be a run-time error.
#[visibility = public]
function show_format(name: string, count: sinteger32): string
    print!("name: {}, count: {}", name, count);
    log!(info, "count is {}", count);
    return format!("{} has {} items", name, count);
end

-- A condition that is true in every correct program. Both stop with a message.
#[visibility = public]
function divide(left: sinteger32, right: sinteger32): sinteger32
    assert!(right != 0, "right must not be zero");
    debug_assert!(left >= 0, "left is not negative in the tests");
    return left / right;
end

-- A check of a layout at compile time. The build stops if the size or the alignment changes.
static_assert!(size_of<layout.Light>() == 32, "Light must use 32 bytes");
static_assert!(align_of<layout.Light>() == 16, "Light must align to 16 bytes");

-- A file embedded at compile time. Nothing is read when the program runs.
constant VERTEX_SHADER: string = include_text!("shaders/triangle.vert");
constant LOGO: c.array<uinteger8> = include_bytes!("images/logo.bin");

-- unreachable!() after a branch that cannot happen.
#[visibility = public]
function sign_name(value: sinteger32): string
    if value < 0 then
        return "negative";
    end
    elseif value == 0 then
        return "zero";
    end
    elseif value > 0 then
        return "positive";
    end
    end
    unreachable!();
end

-- A place of the call, as constants, for a message that names where it comes from.
#[visibility = public]
function where_am_i(): string
    return format!("{}:{} in {}", file!(), line!(), namespace!());
end
