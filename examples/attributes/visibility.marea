-- Step 8: attributes. #[key = value, flag, ...] goes on the line before ANY symbol:
-- constant, structure, enum, type, function and implementation. An attribute line has no ";".
-- A key without a value means "= true". A key that is not an enum key takes true or false.
-- A key of an enum takes one member of that enum: inline = force, build = debug.
-- Visibility is an attribute. There is no public or local keyword.
--   #[public]   other files can import the symbol
--   #[private]  only this file can use it. This is the default, so it can be left out.
-- #[public, private] on one symbol is an error. An unknown key is an error.

namespace attributes.visibility;

#[public]
constant VERSION: integer32 = 1;

#[private]
constant SECRET: integer32 = 42;

constant ALSO_PRIVATE: integer32 = 43;

function hidden(): integer32
    return ALSO_PRIVATE;
end

#[public]
function visible(): integer32
    return hidden() + SECRET;
end
