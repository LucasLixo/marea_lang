-- Step 5: functions and function types.
-- A function name is declared before it is used. There is no forward reference.
-- A function with a return type ends every path with an explicit "return value;". The last
-- expression of a body is NOT a return value. A function without a return type writes no
-- ": Type", and it may use "return;" to leave early.

namespace basics.functions;

require demo.io;

-- A function type has its own name. It is a type name, so it uses PascalCase.
#[visibility = public]
type BinaryOperation = function(left: sinteger32, right: sinteger32): sinteger32;

-- The type of a function without a result has no ": Type". Its call can not give a value.
#[visibility = public]
type Callback = function(text: string);

function add(left: sinteger32, right: sinteger32): sinteger32
    return left + right;
end

function multiply(left: sinteger32, right: sinteger32): sinteger32
    return left * right;
end

-- A function is a value of a function type.
#[visibility = public]
function apply(operation: BinaryOperation, left: sinteger32, right: sinteger32): sinteger32
    return operation(left, right);
end

-- No return type: it returns nothing.
function log_line(text: string)
    if text == "" then
        return;
    end
    demo.io.puts(text);
end

#[visibility = public]
function show_functions(): sinteger32
    local first: sinteger32 = apply(add, 2, 3);
    local second: sinteger32 = apply(multiply, 2, 3);
    local callback: Callback = log_line;
    callback("done");
    return first + second;
end
