-- Step 6: ownership. Every value that is not a primitive or an enum has exactly one owner: a
-- variable, a field or a scope. A reference lives only for one call. It is never stored and
-- never returned. How a value is passed is the "semantics" attribute on the parameter:
--   primitive or enum type                       by value (a copy)
--   any other type, no attribute written          a read-only borrow (reference_read_only, the
--                                                  default for every non-primitive type)
--   #[semantics = reference_read_only]             a read-only borrow, same as no attribute
--   #[semantics = reference_mutable]               an exclusive write borrow, written on purpose
--   #[semantics = value_read_only]                 legal only on a primitive; a copy, same as no
--                                                  attribute there
--   owned<T>                     the call takes the owner: the caller writes "move"
-- Assignment: "=" copies a primitive and an enum. For any other type, when the right
-- side is an existing name, field or element, it is "copy x" (a second owner) or "move x" (the
-- new owner, the old name ends). Plain "=" there is an error, and the message names both
-- choices. A new value (a call or a literal) needs no word, because it has no other owner.
-- A function gives data to its caller with "return value;". That moves the owner up to the
-- scope of the caller. Data only goes up, to a scope that contains the current one.

namespace basics.ownership;

-- A small structure. Even holding only two numbers, it is not a primitive or an enum, so it is
-- still borrowed, copied on purpose with "copy", or moved with "move" like any other structure.
#[visibility = public]
structure Point
    x: float64;
    y: float64;
end

-- A normal type. It is borrowed, copied on purpose, or moved.
#[visibility = public]
structure Shape
    center: Point;
    width: float64;
    height: float64;
end

-- #[semantics = reference_read_only]: a read-only borrow, the same as writing no attribute. The
-- function can not change the shape.
function area(#[semantics = reference_read_only] shape: Shape): float64
    return shape.width * shape.height;
end

-- #[semantics = reference_mutable]: an exclusive write borrow, written on purpose. Nobody else
-- reads the shape while this call runs.
function grow(#[semantics = reference_mutable] shape: Shape, factor: float64)
    shape.width *= factor;
    shape.height *= factor;
end

-- A structure is never copied by assignment alone. The explicit write borrow makes the call
-- change the caller's point.
function move_right(#[semantics = reference_mutable] point: Point, distance: float64)
    point.x += distance;
end

-- The function creates a shape and gives it to the caller. The owner goes up.
function make_shape(width: float64, height: float64): Shape
    local result: Shape = Shape{
        center = Point{ x = 0.0, y = 0.0 },
        width = width,
        height = height,
    };
    return result;
end

-- owned<Shape>: the call takes the owner. The caller writes "move".
function consume(shape: owned<Shape>): float64
    return area(shape);
end

#[visibility = public]
function show_ownership(): float64
    local first: Shape = make_shape(2.0, 3.0);
    local second: Shape = copy first;       -- two owners, two shapes
    grow(second, 2.0);                      -- first is not changed
    local point: Point = copy first.center; -- Point is a structure: "copy" makes a second owner
    move_right(point, 1.5);
    local total: float64 = area(first);     -- a borrow, first stays valid
    local moved: owned<Shape> = move second;
    total += consume(move moved);           -- moved ends here
    return total;
end
